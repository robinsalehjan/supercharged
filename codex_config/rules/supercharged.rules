# Mirrors the Claude Code hard-deny rules that Codex prefix rules can express.
# Keep broader policy in agent_config/AGENTS.md; keep local allow approvals in
# ~/.codex/rules/default.rules.

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Do not run destructive recursive removals.",
    match = ["rm -rf build"],
    not_match = ["rm -r build"],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Do not run privileged commands from agent sessions.",
    match = ["sudo make install"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Do not discard worktree changes destructively.",
    match = ["git reset --hard"],
)

prefix_rule(
    pattern = ["git", "clean", "-f"],
    decision = "forbidden",
    justification = "Do not delete untracked files destructively.",
    match = ["git clean -f"],
)

prefix_rule(
    pattern = ["git", "commit", "--no-verify"],
    decision = "forbidden",
    justification = "Do not bypass commit hooks.",
    match = ["git commit --no-verify -m test"],
)

prefix_rule(
    pattern = ["git", "push", "--no-verify"],
    decision = "forbidden",
    justification = "Do not bypass push hooks.",
    match = ["git push --no-verify"],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Do not force-push from agent sessions.",
    match = ["git push --force"],
)

# Flag-order and long-form variants of the rules above. Prefix rules match a
# literal token sequence, so each spelling an agent could reach for needs its
# own rule.

prefix_rule(
    pattern = ["rm", "-fr"],
    decision = "forbidden",
    justification = "Do not run destructive recursive removals.",
    match = ["rm -fr build"],
    not_match = ["rm -f build"],
)

prefix_rule(
    pattern = ["rm", "-r", "-f"],
    decision = "forbidden",
    justification = "Do not run destructive recursive removals.",
    match = ["rm -r -f build"],
    not_match = ["rm -r build"],
)

prefix_rule(
    pattern = ["rm", "-f", "-r"],
    decision = "forbidden",
    justification = "Do not run destructive recursive removals.",
    match = ["rm -f -r build"],
    not_match = ["rm -f build"],
)

prefix_rule(
    pattern = ["rm", "--recursive", "--force"],
    decision = "forbidden",
    justification = "Do not run destructive recursive removals.",
    match = ["rm --recursive --force build"],
)

prefix_rule(
    pattern = ["rm", "--force", "--recursive"],
    decision = "forbidden",
    justification = "Do not run destructive recursive removals.",
    match = ["rm --force --recursive build"],
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Do not force-push from agent sessions.",
    match = ["git push -f origin main"],
)

prefix_rule(
    pattern = ["git", "clean", "-fd"],
    decision = "forbidden",
    justification = "Do not delete untracked files destructively.",
    match = ["git clean -fd"],
)

prefix_rule(
    pattern = ["git", "clean", "-df"],
    decision = "forbidden",
    justification = "Do not delete untracked files destructively.",
    match = ["git clean -df"],
)

prefix_rule(
    pattern = ["git", "clean", "-xdf"],
    decision = "forbidden",
    justification = "Do not delete untracked files destructively.",
    match = ["git clean -xdf"],
)

prefix_rule(
    pattern = ["git", "clean", "--force"],
    decision = "forbidden",
    justification = "Do not delete untracked files destructively.",
    match = ["git clean --force"],
)
