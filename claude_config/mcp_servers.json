{
  "axiom": {
    "command": "npx",
    "args": [
      "-y",
      "axiom-mcp@27.1.2"
    ]
  },
  "firebase-tools": {
    "command": "npx",
    "args": [
      "-y",
      "firebase-tools@15.32.1",
      "mcp",
      "--dir",
      "."
    ],
    "env": {
      "IS_FIREBASE_MCP": "true"
    }
  },
  "openwiki": {
    "command": "openwiki",
    "args": [
      "mcp",
      "--host",
      "claude"
    ]
  }
}
